scope: {{ postgres_cluster_scope }}
name: postgres-shared-{{ pg_node_index }}

restapi:
  listen: 0.0.0.0:{{ postgres_cluster_patroni_rest_port }}
  connect_address: "{{ ansible_host }}:{{ postgres_cluster_patroni_rest_port }}"

etcd3:
  hosts:
    - "{{ hostvars['postgres-shared-1'].ansible_host }}:{{ postgres_cluster_etcd_client_port }}"
    - "{{ hostvars['postgres-shared-2'].ansible_host }}:{{ postgres_cluster_etcd_client_port }}"
    - "{{ hostvars['postgres-shared-3'].ansible_host }}:{{ postgres_cluster_etcd_client_port }}"

bootstrap:
  # So roda na primeira vez que o CLUSTER inteiro nasce (o no que ganhar a
  # corrida pelo lock do etcd) -- os outros 2 nos so clonam via pg_basebackup
  # do lider, nunca re-executam isto.
  dcs:
    ttl: 30
    loop_wait: 10
    retry_timeout: 10
    maximum_lag_on_failover: 1048576
    postgresql:
      use_pg_rewind: true
      parameters:
        wal_level: replica
        hot_standby: "on"
        max_wal_senders: 5
        max_replication_slots: 5
  initdb:
    - encoding: UTF8
    - data-checksums
  pg_hba:
    - host replication replicator 192.168.15.0/24 md5
    - host all all 192.168.15.0/24 md5
    - local all all trust

postgresql:
  listen: 0.0.0.0:{{ postgres_cluster_pg_port }}
  connect_address: "{{ ansible_host }}:{{ postgres_cluster_pg_port }}"
  data_dir: /var/lib/postgresql/{{ postgres_cluster_pg_version }}/patroni
  bin_dir: /usr/lib/postgresql/{{ postgres_cluster_pg_version }}/bin
  authentication:
    replication:
      username: replicator
      password: "{{ postgres_cluster_replicator_password }}"
    superuser:
      username: postgres
      password: "{{ postgres_cluster_superuser_password }}"

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false
